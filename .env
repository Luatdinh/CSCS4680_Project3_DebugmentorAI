# Copy this file to .env in the PROJECT ROOT.
# Ollama Cloud API key: https://ollama.com/settings/keys
# Never commit .env to GitHub or paste the key into React code.
OLLAMA_API_KEY=
# Ollama cloud model name (see https://ollama.com/search?c=cloud).
# Use the direct cloud API model name, e.g., gemma4:31b (NOT gemma4:cloud).
OLLAMA_MODEL=gemma4:31b
PORT=3001
